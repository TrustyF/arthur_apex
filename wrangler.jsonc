{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arthur-apex",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
